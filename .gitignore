# Project-root gitignore — applies across mobile/ and backend/.
node_modules/

# Env
.env
.env.local
*.local

# macOS / Windows
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/*
!.vscode/extensions.json

# Build artefacts
dist/
build/
.expo/
*.tsbuildinfo

# Native build outputs (when prebuild is run)
ios/
android/

# EAS / Supabase secrets
pc-api-service-account.json
supabase/.temp/
.supabase/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated types
**/expo-env.d.ts
